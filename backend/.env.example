PORT=5000
MONGO_URI=mongodb+srv://<database-user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
GROQ_API_KEY=replace-with-your-groq-key
# Production email (Mailjet HTTP API; validate the sender address in Mailjet first)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
EMAIL_FROM=you@example.com
# Local-only alternative: Gmail SMTP (not available from Render free services)
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your-gmail-app-password
FRONTEND_URL=https://your-app.vercel.app
